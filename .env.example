# Copy to .env and fill in. NEVER commit the real .env file.
#
# Credentials can come from any ONE of these, highest precedence first:
#   1. --credentials PATH                   (CLI flag)
#   2. WQBRAIN_CREDENTIALS_FILE             (path to a JSON file)
#   3. WQBRAIN_USERNAME / WQBRAIN_PASSWORD  (the two below)
#   4. ./credentials.json                   (auto-discovered, gitignored)
#
# The JSON file shape is: {"email": "you@example.com", "password": "..."}
# A template already exists at credentials.json in the project root.

WQBRAIN_USERNAME=you@example.com
WQBRAIN_PASSWORD=changeme

# Optional: point at a credentials JSON file kept outside the repo
# WQBRAIN_CREDENTIALS_FILE=~/secrets/brain.json

# Optional overrides
# WQBRAIN_BASE_URL=https://api.worldquantbrain.com
# WQBRAIN_DB_PATH=data/worldquant.db
# WQBRAIN_LOG_LEVEL=INFO
# WQBRAIN_YEARLY_PATH=/alphas/{alpha_id}/recordsets/yearly-stats
